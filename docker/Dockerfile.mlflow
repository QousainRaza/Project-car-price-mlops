FROM python:3.11-slim
# Versions are pinned on purpose: a newer SQLAlchemy can break MLflow.
RUN pip install --no-cache-dir "mlflow==2.22.5" "sqlalchemy==2.0.57"
EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////data/mlflow.db", \
     "--serve-artifacts", "--artifacts-destination", "/data/artifacts"]
